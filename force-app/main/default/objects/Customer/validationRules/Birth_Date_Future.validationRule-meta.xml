<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Birth_Date_Future</fullName>
    <active>true</active>
    <description>Birth Date cannot be a future date.</description>
    <errorConditionFormula>Birth_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Birth_Date__c</errorDisplayField>
    <errorMessage>Birth Date cannot be a future date.</errorMessage>
</ValidationRule>
